{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biovolt.local/schemas/device-command.v1.schema.json",
  "title": "BioVolt Device Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "command_id", "device_id", "experiment_id", "issued_at", "expires_at", "ttl_ms", "kind", "payload"],
  "properties": {
    "schema_version": {"const": "device-command.v1"},
    "command_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "device_id": {"type": "string", "minLength": 1, "maxLength": 64},
    "experiment_id": {"type": ["string", "null"], "maxLength": 64},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "ttl_ms": {"type": "integer", "minimum": 1, "maximum": 600000},
    "kind": {"enum": ["set_mode", "set_led_pwm", "set_mixer", "request_status", "safe_stop"]},
    "payload": {"type": "object"}
  },
  "oneOf": [
    {"properties": {"kind": {"const": "set_mode"}, "payload": {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["monitor", "passive", "manual", "adaptive"]}}}}},
    {"properties": {"kind": {"const": "set_led_pwm"}, "payload": {"type": "object", "additionalProperties": false, "required": ["pwm"], "properties": {"pwm": {"type": "integer", "minimum": 0, "maximum": 255}}}}},
    {"properties": {"kind": {"const": "set_mixer"}, "payload": {"type": "object", "additionalProperties": false, "required": ["on"], "properties": {"on": {"type": "boolean"}}}}},
    {"properties": {"kind": {"const": "request_status"}, "payload": {"type": "object", "additionalProperties": false, "maxProperties": 0}}},
    {"properties": {"kind": {"const": "safe_stop"}, "payload": {"type": "object", "additionalProperties": false, "maxProperties": 0}}}
  ]
}
