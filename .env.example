BIOVOLT_ENVIRONMENT=development
# The Compose stack uses /data inside the backend container. The local
# development default below remains relative to the repository root.
BIOVOLT_DATABASE_URL=sqlite+aiosqlite:///../data/biovolt.db
# Replace this value before starting the backend or simulator.
BIOVOLT_DEVICE_SHARED_TOKEN=replace-with-a-long-random-token
BIOVOLT_LOAD_RESISTANCE_OHM=100000

# Optional OD680 calibration values. Leave these commented out when unused;
# an empty value is not a valid float for Pydantic Settings.
# BIOVOLT_BPW34_DARK_RAW=320
# BIOVOLT_BPW34_BLANK_RAW=23840
